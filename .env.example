# shadow = live MAINNET data, simulated fills (needs only API_KEY)
# test   = TESTNET orders with testnet collateral
# live   = MAINNET real orders (also needs ALLOW_LIVE=true)
START_MODE=shadow
ALLOW_LIVE=false

API_KEY=                   # mainnet key (shadow + live)
API_KEY_TESTNET=           # usually not required
SIGNER_PRIVATE_KEY=        # test + live only. Use a dedicated wallet.
PREDICT_ACCOUNT=           # optional Predict account address
RPC_URL=                   # BNB mainnet RPC (needed for claim/redeem)
RPC_URL_TESTNET=
# WS_URL_MAINNET=wss://ws.predict.fun/ws
# WS_URL_TESTNET=wss://ws.predict.fun/ws

DASH_PORT=8787
DASH_TOKEN=                # blank = random token each start (printed in console)
